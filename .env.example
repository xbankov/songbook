# PostgreSQL
POSTGRES_DB=songbook
POSTGRES_USER=songbook
POSTGRES_PASSWORD=changeme

# Backend
ENVIRONMENT=production
SECRET_KEY=changeme-secret-key-rotate-in-production
CORS_ORIGINS=http://localhost:8081,http://localhost:5173
DATABASE_URL=postgresql+asyncpg://songbook:changeme@postgres:5432/songbook
REDIS_URL=redis://redis:6379/0

# Auth (single shared credential)
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# Public HTTPS (docker-compose.tls.yml, see docs/deployment.md)
# DOMAIN=songs.example.com
# ACME_EMAIL=you@example.com

# Frontend
VITE_API_URL=http://localhost:8000
